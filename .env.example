# Supabase project (Project Settings → API). Required in production.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public anon / publishable key: only used for Realtime subscriptions (broadcast + presence).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose. Used by /api/rooms/* to read and write the `rooms` table.
SUPABASE_SERVICE_ROLE_KEY=

# Dev/testing: allow starting online games with 3+ players instead of 8+.
ALLOW_SMALL_ROOMS=0
